// A complete map for the contract test: every kind of logical name the core steps use.
import { add } from '../sample/domain';

export interface Api {
  method: string;
  path: string;
}

export interface ErrorRule {
  statuses?: number[];
  exception?: string;
  exitCode?: number;
  text?: string;
}

export const API: Record<string, Api> = {
  'place order': { method: 'POST', path: '/orders' },
  'list orders': { method: 'GET', path: '/orders' },
  'look up time': { method: 'GET', path: '/time' },
};

export const COMMANDS: Record<string, string[]> = {
  'show version': ['node', '-e', "console.log('node ok')"],
  'misuse the tool': ['node', '-e', "console.error('unknown command'); process.exit(2)"],
};

export const LIB: Record<string, (...args: never[]) => unknown> = {
  add: ({ a, b }: { a: number; b: number }) => add(a, b),
  describe: ({ name }: { name: string }) => ({ name, lines: [{ sku: 'a1' }] }),
  refuse: ({ name }: { name: string }) => {
    throw new Error(`refused: ${name}`);
  },
};

export const FILES: Record<string, string> = { report: 'out/report.txt' };

export const ERRORS: Record<string, ErrorRule> = {
  'negative input': { exception: 'RangeError' },
  unauthorised: { statuses: [401, 403] },
  'unknown command': { text: 'unknown command' },
  refusal: { text: 'refused' },
};
