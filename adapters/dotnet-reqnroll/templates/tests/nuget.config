<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org, whatever the machine or a parent folder configures: the packages come from one place and are checked against packages.lock.json. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
